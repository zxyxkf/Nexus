# ===== Nexus 服务端环境变量模板 =====
# 复制此文件为 .env.development 或 .env.production 使用

# ---- 运行环境 ----
# development | production
NODE_ENV=development

# ---- 服务 ----
PORT=18632
HOST=0.0.0.0

# ---- JWT 认证 ----
# 生产环境必须更换为随机字符串（建议 32 字符以上）
JWT_SECRET=请更换为随机字符串
# access token 有效期（默认 10m）：泄露后最大攻击窗口
# JWT_ACCESS_EXPIRES_IN=10m
# refresh token 有效期（默认 7d）：用户免登录时长
# JWT_REFRESH_EXPIRES_IN=7d

# ---- 数据库引擎 ----
# 0 = SQLite（默认，零配置开箱即用）
# 1 = MySQL（需配置下方 DB_HOST 等连接信息）
USE_MYSQL=0

# ---- MySQL 连接（仅 USE_MYSQL=1 时需要） ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=d_design
DB_PASSWORD=请更换为安全密码
DB_NAME=d_design_art

# ---- 上传目录（可选，默认 ./upload） ----
# UPLOAD_DIR=./upload

# ---- 日志目录（可选，默认 ./logs） ----
# LOG_DIR=./logs
